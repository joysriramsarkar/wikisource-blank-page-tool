
# Local environment for the Next.js app.
# SESSION_SECRET must be a long random string (32+ characters).
SESSION_SECRET=replace-with-a-long-random-string
# Optional custom User-Agent for the MediaWiki API.
# Wikimedia rate limits: a User-Agent without contact info is limited to
# 10 requests/minute; one with a URL/email gets 200 requests/minute.
# Keep a contact URL or email in this value.
WIKI_USER_AGENT=WikisourceBlankPageTool/2.0 (https://github.com/joysriramsarkar/wikisource-blank-page-tool)
